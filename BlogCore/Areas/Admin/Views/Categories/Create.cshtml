@model BlogCore.Models.CategoryModel

@{
    ViewData["Title"] = "Create Category";
}


<br />
<br />

<h3 class="text-center">Crear una nueva categoria</h3>
<form method="POST" asp-action="Create">
    <div class="row px-2 offset-1 border">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col offset-1 mt-4">
            <div class="form-group row">
              <div class="4">
                    <label asp-for="NameCategory" class="control-label"></label>
              </div>
              <div>
                    <input asp-for="NameCategory" class="form-control" placeholder="Agrega el nómbre de la categoria" />
                    <span asp-validation-for="NameCategory" class="text-danger"></span>
              </div>
                <br />
    
              <div class="4">
                    <label asp-for="Order" class="control-label"></label>
              </div>
              <div>
                    <input asp-for="Order" class="form-control" placeholder="Agrega el nómbre de la categoria" />
                    <span asp-validation-for="Order" class="text-danger"></span>
              </div>
            
             </div>
            </div>
            <div class="form-group-row">
                <div class="col-8">
                    <partial name="_VistaCrearVolver"></partial>
                </div>
            </div>
        </div>
    </div>
</form>