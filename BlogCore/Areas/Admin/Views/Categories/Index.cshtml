
<div class="container mt-4">
    <div class="row">
        <div class="col-8">
            <h2 class="text-primary">Lista de Categorias</h2>            
        </div>
        <div class="col-4 text-right">
            <a asp-controller="Categories" asp-action="Create" class="btn btn-primary mb-2"><i class="fas fa-plus"></i> Crear Categoria</a>
        </div>
    </div>

    <br/>
    <br/>

   <table id="tblCategories" class="table table-striped table-bordered" style="width:100%">
       <thead>
           <tr>
                <th>Id</th>
                <th>Nombre de la categoria</th>
                <th>Orden</th>
               <th>Acciones</th>
           </tr>
           
       </thead>
   </table>



</div>
@section Scripts {
    <script src="~/js/category.js"></script>

}